---
// SEO Head component - shared across all layouts
// Import inside <head> tag, outputs meta tags (no wrapper)

import { SITE } from '@/config/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  noIndex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  canonicalUrl,
  jsonLd,
  noIndex,
} = Astro.props;

const finalImage = image || SITE.image;

// Use provided canonical URL or generate from current path
const finalCanonicalURL = canonicalUrl || new URL(Astro.url.pathname, SITE.url).toString();
const ogImageURL = finalImage.startsWith('http') ? finalImage : new URL(finalImage, SITE.url).toString();
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={finalCanonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={finalCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Page Title -->
<title>{title}</title>

<!-- Structured Data / JSON-LD -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
)}

<link rel="icon" type="image/svg+xml" href="https://pagesmith-cdn.com/ab210347/favicons/favicon-5c67e181.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://pagesmith-cdn.com/ab210347/favicons/apple-touch-icon-5c67e181.png" />
