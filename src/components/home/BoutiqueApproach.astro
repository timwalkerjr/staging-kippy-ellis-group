---
// Buying / Selling Section - Boutique Approach
---

<section id="buying-selling" class="bg-white py-20 lg:py-24 border-t border-border" data-ps="src/components/home/BoutiqueApproach.astro:boutique-sec">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/components/home/BoutiqueApproach.astro:hb525z">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center" data-ps="src/components/home/BoutiqueApproach.astro:hb5260">
      <!-- Left Column: Photo of West Michigan home for sale -->
      <div class="lg:col-span-6" data-ps="src/components/home/BoutiqueApproach.astro:hb5261">
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/11] rounded-[12px] overflow-hidden shadow-xs border border-border" data-ps="src/components/home/BoutiqueApproach.astro:hb5262">
          <img
            src="https://pagesmith-cdn.com/ab210347/images/e21f6ef4f3550031aba786213f9a8c62-1536.webp"
            alt="West Michigan home for sale"
            class="w-full h-full object-cover"
            loading="lazy" data-ps="src/components/home/BoutiqueApproach.astro:esvxui" />
        </div>
      </div>

      <!-- Right Column: Features -->
      <div class="lg:col-span-6" data-ps="src/components/home/BoutiqueApproach.astro:hb5263">
        <span class="text-[12px] font-bold text-primary tracking-[0.15em] uppercase mb-2 block" data-ps="src/components/home/BoutiqueApproach.astro:nvo7ch">Buying / Selling</span>
        <h2 class="font-heading text-[30px] sm:text-[34px] lg:text-[38px] font-normal text-foreground leading-[1.2] mb-8" data-ps="src/components/home/BoutiqueApproach.astro:3zubd9">
          A thoughtful, boutique approach to every transaction
        </h2>

        <div class="flex flex-col gap-6" data-ps="src/components/home/BoutiqueApproach.astro:2ul73h">
          <!-- Item 1: Buyer Representation -->
          <div class="flex items-start gap-4" data-ps="src/components/home/BoutiqueApproach.astro:2ul73i">
            <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-1" data-ps="src/components/home/BoutiqueApproach.astro:2ul73j">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <div data-ps="src/components/home/BoutiqueApproach.astro:2ul73k">
              <h3 class="font-heading text-[18px] font-normal text-foreground mb-1" data-ps="src/components/home/BoutiqueApproach.astro:aoklue">Buyer Representation</h3>
              <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/BoutiqueApproach.astro:y48o4o">
                From neighborhood scouting to negotiation, we protect your interests every step of the way.
              </p>
            </div>
          </div>

          <!-- Item 2: Seller Strategy -->
          <div class="flex items-start gap-4" data-ps="src/components/home/BoutiqueApproach.astro:2ul73l">
            <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-1" data-ps="src/components/home/BoutiqueApproach.astro:2ul73m">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div data-ps="src/components/home/BoutiqueApproach.astro:2ul73n">
              <h3 class="font-heading text-[18px] font-normal text-foreground mb-1" data-ps="src/components/home/BoutiqueApproach.astro:aoklud">Seller Strategy</h3>
              <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/BoutiqueApproach.astro:y48o4n">
                Pricing, staging, and marketing built around data -- not guesswork. Our listings move fast.
              </p>
            </div>
          </div>

          <!-- Item 3: Land & Commercial -->
          <div class="flex items-start gap-4" data-ps="src/components/home/BoutiqueApproach.astro:2ul73o">
            <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-1" data-ps="src/components/home/BoutiqueApproach.astro:2ul73p">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div data-ps="src/components/home/BoutiqueApproach.astro:2ul73q">
              <h3 class="font-heading text-[18px] font-normal text-foreground mb-1" data-ps="src/components/home/BoutiqueApproach.astro:aokluc">Lakeshore & Residential</h3>
              <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/BoutiqueApproach.astro:y48o4m">
                Residential, waterfront, and investment expertise across Grand Rapids, Holland, and West Michigan.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
