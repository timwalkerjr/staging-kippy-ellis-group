---
// Hero Section
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const reviews = allReviews.sort((a, b) => a.data.order - b.data.order);
---

<section id="hero" class="relative bg-black overflow-hidden" data-ps="src/components/home/Hero.astro:hero-sec">
  <!-- Full-bleed background image with literal CDN URL -->
  <img
    src="https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-1536.webp"
    srcset="https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-1536.webp 1536w, https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-1024.webp 1024w, https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-768.webp 768w, https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-640.webp 640w, https://pagesmith-cdn.com/ab210347/images/solitsocial-dot-com-QpNX4cwzXwk-unsplash-1536-e886cb-320.webp 320w"
    sizes="100vw"
    alt="West Michigan Lake Michigan shoreline"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    data-ps="src/components/home/Hero.astro:hero-bg"
  />

  <!-- Exact Gradient Scrim overlay from design spec: dark on left, revealing image on right -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/30 pointer-events-none" data-ps="src/components/home/Hero.astro:overlay"></div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-[1440px] w-full mx-auto px-6 sm:px-8 lg:px-12 pt-12 sm:pt-16 lg:pt-20 pb-[3.3rem] sm:pb-[4.4rem] lg:pb-[5.5rem]" data-ps="src/components/home/Hero.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center" data-ps="src/components/home/Hero.astro:grid">
      <!-- Left Column: Headline, Copy & CTAs -->
      <div class="lg:col-span-7" data-ps="src/components/home/Hero.astro:content-col">
        <!-- Main Headline (First TEXT in hero) -->
        <h1 class="font-heading text-[38px] sm:text-[46px] lg:text-[54px] font-normal text-white leading-[1.12] tracking-normal mb-6" data-ps="src/components/home/Hero.astro:headline">
          Your Home, My Priority — Guiding Your Next Move in West Michigan
        </h1>

        <!-- Body Copy -->
        <p class="text-[16px] sm:text-[18px] text-gray-200 leading-[28px] font-normal max-w-[620px] mb-8" data-ps="src/components/home/Hero.astro:desc">
          Welcome to Kippy Ellis Group with Five Star Real Estate. Dedicated to providing exceptional, personalized real estate services across West Michigan, from vibrant city neighborhoods to peaceful lakeshore retreats.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4" data-ps="src/components/home/Hero.astro:buttons">
          <a
            href="/#contact"
            class="inline-flex items-center gap-2.5 bg-primary hover:bg-primary-hover text-white text-[14px] font-semibold px-6 py-3.5 rounded-[6px] transition-colors shadow-sm no-underline"
            data-ps="src/components/home/Hero.astro:iblyyk">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span data-ps="src/components/home/Hero.astro:3f6ipd">Explore Your Options</span>
          </a>

          <a
            href="/#contact"
            class="inline-flex items-center gap-2.5 bg-white hover:bg-gray-100 text-foreground text-[14px] font-semibold px-6 py-3.5 rounded-[6px] transition-colors shadow-sm no-underline"
            data-ps="src/components/home/Hero.astro:iblyyj">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span data-ps="src/components/home/Hero.astro:3f6ipc">Contact Kippy</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Glassmorphism Reviews Slider Card -->
      {reviews.length > 0 && (
        <div class="lg:col-span-5 w-full max-w-[480px] lg:max-w-none mx-auto" data-ps="src/components/home/Hero.astro:slider-wrapper">
          <div
            id="hero-reviews-slider"
            class="relative rounded-2xl bg-slate-950/60 backdrop-blur-md border border-white/20 p-6 sm:p-7 shadow-2xl text-white transition-all overflow-hidden"
            data-ps="src/components/home/Hero.astro:glass-card">
            <!-- Header Row: Rating Badge -->
            <div class="flex items-center justify-between gap-2 mb-3" data-ps="src/components/home/Hero.astro:slider-badge">
              <div class="flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase" data-ps="src/components/home/Hero.astro:ecxgfb">
                <svg class="w-3.5 h-3.5 fill-current text-amber-400" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span class="text-white" data-ps="src/components/home/Hero.astro:3f6ipi">5.0 · Client Reviews</span>
              </div>
              <span class="text-[11px] text-gray-400 font-medium" data-ps="src/components/home/Hero.astro:3f6iph">Verified Feedback</span>
            </div>

            <!-- 5 Star Icons -->
            <div class="flex items-center gap-1 text-amber-400 mb-4" data-ps="src/components/home/Hero.astro:stars">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Review Slides Container -->
            <div class="relative min-h-[148px]" data-ps="src/components/home/Hero.astro:slides-container">
              {reviews.map((review, idx) => (
                <div
                  class={`hero-review-slide transition-opacity duration-500 ease-in-out ${idx === 0 ? 'opacity-100 relative z-10' : 'opacity-0 absolute inset-0 pointer-events-none'}`}
                  data-slide-index={idx}
                  data-ps={`src/components/home/Hero.astro:slide-${idx}`}>
                  <p class="text-[14px] sm:text-[15px] text-gray-200 leading-relaxed font-normal line-clamp-4 min-h-[4.8rem]" data-ps={`src/components/home/Hero.astro:ijv6zc-${idx}`}>
                    "{review.data.body || review.data.quote}"
                  </p>
                  <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs text-gray-300" data-ps={`src/components/home/Hero.astro:ecxgfc-${idx}`}>
                    <span class="font-medium text-white" data-ps={`src/components/home/Hero.astro:3f6ipg-${idx}`}>— {review.data.name}</span>
                    <span class="text-gray-400" data-ps={`src/components/home/Hero.astro:3f6ipf-${idx}`}>{review.data.date}</span>
                  </div>
                </div>
              ))}
            </div>

            <!-- Slider Pagination Controls -->
            <div class="flex items-center gap-1.5 mt-5 pt-1" data-ps="src/components/home/Hero.astro:dots">
              {reviews.map((_, idx) => (
                <button
                  type="button"
                  aria-label={`Go to review ${idx + 1}`}
                  class={`hero-dot h-2 rounded-full transition-all duration-300 ${idx === 0 ? 'w-6 bg-white' : 'w-2 bg-white/35 hover:bg-white/60'}`}
                  data-dot-index={idx}
                />
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function setupHeroSlider() {
    const slider = document.getElementById('hero-reviews-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll<HTMLElement>('.hero-review-slide');
    const dots = slider.querySelectorAll<HTMLButtonElement>('.hero-dot');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;

    function goToSlide(index: number) {
      if (index === currentIndex) return;
      
      slides.forEach((slide, idx) => {
        if (idx === index) {
          slide.classList.remove('opacity-0', 'absolute', 'pointer-events-none');
          slide.classList.add('opacity-100', 'relative', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'relative', 'z-10');
          slide.classList.add('opacity-0', 'absolute', 'pointer-events-none');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.remove('w-2', 'bg-white/35');
          dot.classList.add('w-6', 'bg-white');
        } else {
          dot.classList.remove('w-6', 'bg-white');
          dot.classList.add('w-2', 'bg-white/35');
        }
      });

      currentIndex = index;
    }

    function nextSlide() {
      const nextIndex = (currentIndex + 1) % slides.length;
      goToSlide(nextIndex);
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = window.setInterval(nextSlide, 6000);
    }

    function stopAutoPlay() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = Number(dot.dataset.dotIndex);
        if (!isNaN(targetIdx)) {
          goToSlide(targetIdx);
          startAutoPlay();
        }
      });
    });

    slider.addEventListener('mouseenter', stopAutoPlay);
    slider.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
  }

  // Setup on initial page load and view transitions
  setupHeroSlider();
  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
