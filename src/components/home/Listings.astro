---
// Popular Listing Categories Section
---

<section id="listings" class="bg-white py-20 lg:py-24" data-ps="src/components/home/Listings.astro:listings-sec">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/components/home/Listings.astro:gmf6dx">
    <!-- Header with 2 columns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14" data-ps="src/components/home/Listings.astro:gmf6dy">
      <div class="lg:col-span-7" data-ps="src/components/home/Listings.astro:gmf6dz">
        <span class="text-[12px] font-bold text-primary tracking-[0.15em] uppercase mb-2 block" data-ps="src/components/home/Listings.astro:3argvo">Explore Listings</span>
        <h2 class="font-heading text-[30px] sm:text-[36px] font-normal text-foreground leading-[1.2]" data-ps="src/components/home/Listings.astro:13s964">
          Here are Some Popular Listing Categories
        </h2>
      </div>
      <div class="lg:col-span-5 text-[15px] text-muted-foreground leading-[24px]" data-ps="src/components/home/Listings.astro:gmf6e0">
        <p data-ps="src/components/home/Listings.astro:f3pvry">
          Reach out to our team and we will help match you with homes that fit your criteria. If you know what you are looking for, <a href="/#contact" class="text-primary hover:text-primary-hover underline underline-offset-2" data-ps="src/components/home/Listings.astro:m7nsgt">contact us</a> and we can help you find the best homes for sale.
        </p>
      </div>
    </div>

    <!-- 3 Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/Listings.astro:gmf6e1">
      <!-- Card 1: Featured Listings -->
      <div class="bg-white border border-border rounded-[8px] overflow-hidden flex flex-col justify-between group shadow-xs hover:shadow-md transition-shadow" data-ps="src/components/home/Listings.astro:gmf6e2">
        <div data-ps="src/components/home/Listings.astro:gmf6e3">
          <a href="/#contact" class="block relative aspect-[16/10] overflow-hidden" data-ps="src/components/home/Listings.astro:m7nsgu">
            <img
              src="https://pagesmith-cdn.com/ab210347/images/00fb8d05642e61c1860215bc5893bab1-1536.webp"
              alt="Featured Listings"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy" data-ps="src/components/home/Listings.astro:e4621t" />
          </a>
          <div class="p-6" data-ps="src/components/home/Listings.astro:gmf6e4">
            <div class="flex items-center justify-between gap-2 mb-2" data-ps="src/components/home/Listings.astro:gmf6e5">
              <h3 class="font-heading text-[20px] font-normal text-foreground" data-ps="src/components/home/Listings.astro:fs76dr">Featured Listings</h3>
              <a href="/#contact" class="text-muted-foreground group-hover:text-primary transition-colors" aria-label="Ask About Homes" data-ps="src/components/home/Listings.astro:m7nsgv">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
            </div>
            <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/Listings.astro:f3pvsk">
              Hand-picked homes currently on the market with our team.
            </p>
          </div>
        </div>
        <div class="p-6 pt-0" data-ps="src/components/home/Listings.astro:gmf6e6">
          <a
            href="/#contact"
            class="w-full inline-flex items-center justify-center gap-2 border border-primary text-primary hover:bg-primary hover:text-white font-semibold text-[13px] py-2.5 px-4 rounded-[6px] transition-colors no-underline"
           data-ps="src/components/home/Listings.astro:m7nsgw">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span data-ps="src/components/home/Listings.astro:3argvp">Ask About Homes</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Land and Farm -->
      <div class="bg-white border border-border rounded-[8px] overflow-hidden flex flex-col justify-between group shadow-xs hover:shadow-md transition-shadow" data-ps="src/components/home/Listings.astro:d7mcye">
        <div data-ps="src/components/home/Listings.astro:d7mcyd">
          <a href="/#contact" class="block relative aspect-[16/10] overflow-hidden" data-ps="src/components/home/Listings.astro:m7nsgx">
            <img
              src="https://pagesmith-cdn.com/ab210347/images/756572f78b69bac6aa568ea4ad2df5c9-768.webp"
              alt="Land and Farm"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy" data-ps="src/components/home/Listings.astro:e4621u" />
          </a>
          <div class="p-6" data-ps="src/components/home/Listings.astro:d7mcyc">
            <div class="flex items-center justify-between gap-2 mb-2" data-ps="src/components/home/Listings.astro:d7mcyb">
              <h3 class="font-heading text-[20px] font-normal text-foreground" data-ps="src/components/home/Listings.astro:fs76dq">Land and Farm</h3>
              <a href="/#contact" class="text-muted-foreground group-hover:text-primary transition-colors" aria-label="Ask About Land" data-ps="src/components/home/Listings.astro:m7nshj">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
            </div>
            <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/Listings.astro:f3pvsl">
              Rolling acreage, countryside retreats, and wooded properties across West Michigan.
            </p>
          </div>
        </div>
        <div class="p-6 pt-0" data-ps="src/components/home/Listings.astro:d7mcya">
          <a
            href="/#contact"
            class="w-full inline-flex items-center justify-center gap-2 border border-primary text-primary hover:bg-primary hover:text-white font-semibold text-[13px] py-2.5 px-4 rounded-[6px] transition-colors no-underline"
           data-ps="src/components/home/Listings.astro:m7nshk">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span data-ps="src/components/home/Listings.astro:3argvq">Ask About Land</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Luxury Homes -->
      <div class="bg-white border border-border rounded-[8px] overflow-hidden flex flex-col justify-between group shadow-xs hover:shadow-md transition-shadow" data-ps="src/components/home/Listings.astro:d7mcy9">
        <div data-ps="src/components/home/Listings.astro:d7mcy8">
          <a href="/#contact" class="block relative aspect-[16/10] overflow-hidden" data-ps="src/components/home/Listings.astro:m7nshl">
            <img
              src="https://pagesmith-cdn.com/ab210347/images/b836385acb94190f7a2474a3da382383-1536.webp"
              alt="Luxury Homes"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy" data-ps="src/components/home/Listings.astro:e4621v" />
          </a>
          <div class="p-6" data-ps="src/components/home/Listings.astro:d7mcy7">
            <div class="flex items-center justify-between gap-2 mb-2" data-ps="src/components/home/Listings.astro:d7mcy6">
              <h3 class="font-heading text-[20px] font-normal text-foreground" data-ps="src/components/home/Listings.astro:fs76dp">Luxury Homes</h3>
              <a href="/#contact" class="text-muted-foreground group-hover:text-primary transition-colors" aria-label="Ask About Luxury Homes" data-ps="src/components/home/Listings.astro:m7nshm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
            </div>
            <p class="text-[14px] text-muted-foreground leading-[22px]" data-ps="src/components/home/Listings.astro:f3pvsm">
              High-end estates, lakefront retreats, and executive homes in West Michigan.
            </p>
          </div>
        </div>
        <div class="p-6 pt-0" data-ps="src/components/home/Listings.astro:d7mcy5">
          <a
            href="/#contact"
            class="w-full inline-flex items-center justify-center gap-2 border border-primary text-primary hover:bg-primary hover:text-white font-semibold text-[13px] py-2.5 px-4 rounded-[6px] transition-colors no-underline"
           data-ps="src/components/home/Listings.astro:m7nshn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span data-ps="src/components/home/Listings.astro:3argvr">Ask About Luxury Homes</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
