---
// Contact Us Section
---

<section id="contact" class="bg-white py-20 lg:py-24 border-t border-border" data-ps="src/components/home/Contact.astro:contact-sec">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/components/home/Contact.astro:o1wv08">
    <!-- Header -->
    <div class="max-w-[760px] mb-12" data-ps="src/components/home/Contact.astro:o1wv07">
      <span class="text-[12px] font-bold text-primary tracking-[0.15em] uppercase mb-2 block" data-ps="src/components/home/Contact.astro:jamzum">Get In Touch</span>
      <h2 class="font-heading text-[30px] sm:text-[36px] font-normal text-foreground leading-[1.2] mb-3" data-ps="src/components/home/Contact.astro:hp7u1r">
        Contact Us
      </h2>
      <p class="text-[15px] sm:text-[16px] text-muted-foreground leading-[24px]" data-ps="src/components/home/Contact.astro:u4l0a1">
        We appreciate the opportunity to assist you as you buy or sell your home. It's a responsibility and commitment we take seriously.
      </p>
    </div>

    <!-- 2 Columns Grid: Info & Map on Left, Form on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start" data-ps="src/components/home/Contact.astro:o1wv06">
      <!-- Left Column: Info & Map -->
      <div class="lg:col-span-5 flex flex-col gap-6" data-ps="src/components/home/Contact.astro:o1wv05">
        <!-- Address Card -->
        <div class="flex items-start gap-4 p-4 rounded-[8px] bg-surface border border-border" data-ps="src/components/home/Contact.astro:o1wv04">
          <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/Contact.astro:o1wuzi">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div data-ps="src/components/home/Contact.astro:o1wuzh">
            <h3 class="font-heading text-[16px] font-semibold text-foreground mb-1" data-ps="src/components/home/Contact.astro:30swu3">Brokerage & Office</h3>
            <p class="text-[14px] text-muted-foreground leading-[20px]" data-ps="src/components/home/Contact.astro:u4l0a2">
              Five Star Real Estate<br />
              Grand Rapids & Holland, MI
            </p>
          </div>
        </div>

        <!-- Phone Card -->
        <div class="flex items-start gap-4 p-4 rounded-[8px] bg-surface border border-border" data-ps="src/components/home/Contact.astro:o1wuzg">
          <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/Contact.astro:o1wuzf">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div data-ps="src/components/home/Contact.astro:o1wuze">
            <h3 class="font-heading text-[16px] font-semibold text-foreground mb-1" data-ps="src/components/home/Contact.astro:30swu4">Direct Phone</h3>
            <a href="tel:+16164370205" class="text-[14px] text-primary hover:text-primary-hover no-underline font-medium" data-ps="src/components/home/Contact.astro:xsl4zb">
              (616) 437-0205
            </a>
          </div>
        </div>

        <!-- Office Hours Card -->
        <div class="flex items-start gap-4 p-4 rounded-[8px] bg-surface border border-border" data-ps="src/components/home/Contact.astro:o1wuzd">
          <div class="w-10 h-10 rounded-[6px] bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/Contact.astro:o1wuzc">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div data-ps="src/components/home/Contact.astro:o1wuzb">
            <h3 class="font-heading text-[16px] font-semibold text-foreground mb-1" data-ps="src/components/home/Contact.astro:30swu5">Office Hours</h3>
            <p class="text-[14px] text-muted-foreground leading-[20px]" data-ps="src/components/home/Contact.astro:u4l0a3">
              Monday – Saturday · 8:00 am – 7:00 pm (Sunday by Appt)
            </p>
          </div>
        </div>

        <!-- Google Maps Profile Card -->
        <div class="relative w-full rounded-[8px] overflow-hidden border border-border shadow-xs bg-surface p-6 flex flex-col justify-between gap-4" data-ps="src/components/home/Contact.astro:o1wuza">
          <div data-ps="src/components/home/Contact.astro:1ijz2d">
            <div class="flex items-center gap-2 text-primary text-[14px] font-semibold mb-2" data-ps="src/components/home/Contact.astro:1ijz2e">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-ps="src/components/home/Contact.astro:d4img8">Google Business Profile</span>
            </div>
            <h4 class="font-heading text-[18px] font-semibold text-foreground mb-1" data-ps="src/components/home/Contact.astro:gey53o">Kippy Ellis Group - Five Star Real Estate</h4>
            <p class="text-[14px] text-muted-foreground leading-[20px]" data-ps="src/components/home/Contact.astro:crxs8r">
              Find client reviews, business details, and directions for Five Star Real Estate on Google Maps.
            </p>
          </div>
          <a
            href="https://www.google.com/maps/place/Kippy+Ellis+-+Five+Star+Real+Estate/data=!4m2!3m1!1s0x0:0xa30760b97b9eaf09?sa=X&ved=1t:2428&ictx=111"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-white text-[14px] font-semibold py-2.5 px-4 rounded-[6px] transition-colors no-underline"
           data-ps="src/components/home/Contact.astro:cjok81">
            <span data-ps="src/components/home/Contact.astro:d4img9">View on Google Maps</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Form Container -->
      <div class="lg:col-span-7" data-ps="src/components/home/Contact.astro:o1wuz9">
        <div class="bg-surface border border-border rounded-[8px] p-6 sm:p-8 shadow-xs" data-ps="src/components/home/Contact.astro:1ijz25">
          <h3 class="font-heading text-[22px] font-normal text-foreground mb-6" data-ps="src/components/home/Contact.astro:30swu6">Send us a message</h3>

          <form id="contact-form" action="https://formspree.io/f/xljewkqn" method="POST" class="flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/Contact.astro:1ijz26">
              <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz27">
                <label for="firstName" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikb9v">First Name</label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  placeholder="First name"
                  class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
              <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz28">
                <label for="lastName" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikb9w">Last Name</label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  placeholder="Last name"
                  class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/Contact.astro:1ijz29">
              <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz2a">
                <label for="email" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikbai">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
              <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz2b">
                <label for="phone" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikbaj">Phone</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="(616) 000-0000"
                  class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
            </div>

            <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz2c">
              <label for="interest" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikbak">I'm Interested In</label>
              <select
                id="interest"
                name="interest"
                class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              >
                <option value="Buying a home">Buying a home</option>
                <option value="Selling a home">Selling a home</option>
                <option value="Land / Farm">Land / Farm</option>
                <option value="Luxury Homes">Luxury Homes</option>
                <option value="Commercial">Commercial</option>
                <option value="Just exploring">Just exploring</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5" data-ps="src/components/home/Contact.astro:1ijz2d">
              <label for="message" class="text-[13px] font-medium text-foreground" data-ps="src/components/home/Contact.astro:tikbal">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="How can we help you?"
                class="w-full bg-white border border-border rounded-[6px] px-3.5 py-2.5 text-[14px] text-foreground placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-y"
              ></textarea>
            </div>

            <div id="form-status" role="status" aria-live="polite" aria-atomic="true" class="hidden text-[14px] font-medium py-2" data-ps="src/components/home/Contact.astro:1ijz2e"></div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-white font-semibold text-[14px] py-3.5 px-6 rounded-[6px] transition-colors cursor-pointer shadow-xs"
             data-ps="src/components/home/Contact.astro:1yomyo">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span data-ps="src/components/home/Contact.astro:d4imga">Send Message</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const formStatus = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  let isSubmitting = false;

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting || !submitBtn || !formStatus) return;

      isSubmitting = true;
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      const originalHtml = submitBtn.innerHTML;
      submitBtn.innerHTML = 'Sending...';

      // Clear previous status
      formStatus.classList.add('hidden');
      formStatus.textContent = '';
      formStatus.className = 'hidden text-[14px] font-medium py-2';

      const formData = new FormData(contactForm);
      const firstName = (formData.get('firstName') || '').toString().trim();
      const lastName = (formData.get('lastName') || '').toString().trim();
      const fullName = `${firstName} ${lastName}`.trim();
      const interest = (formData.get('interest') || '').toString().trim();

      if (fullName) {
        formData.set('name', fullName);
      }
      formData.set('subject', `Real Estate Inquiry: ${interest || 'General'}`);

      try {
        const res = await fetch(contactForm.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (res.ok) {
          formStatus.textContent = 'Thank you! Your message has been sent successfully.';
          formStatus.className = 'text-green-700 bg-green-50 border border-green-200 rounded-[6px] p-3 text-[14px]';
          formStatus.classList.remove('hidden');
          contactForm.reset();
        } else if (res.status === 429) {
          formStatus.textContent = 'Too many requests. Please try again later.';
          formStatus.className = 'text-red-700 bg-red-50 border border-red-200 rounded-[6px] p-3 text-[14px]';
          formStatus.classList.remove('hidden');
        } else {
          let errorMsg = 'Oops! There was a problem submitting your form. Please try again.';
          try {
            const data = await res.json();
            if (data && Array.isArray(data.errors) && data.errors.length > 0) {
              errorMsg = data.errors.map((err) => err.message || err).join(', ');
            } else if (data && data.error) {
              errorMsg = typeof data.error === 'string' ? data.error : JSON.stringify(data.error);
            }
          } catch (_) {
            // response was not JSON
          }
          formStatus.textContent = errorMsg;
          formStatus.className = 'text-red-700 bg-red-50 border border-red-200 rounded-[6px] p-3 text-[14px]';
          formStatus.classList.remove('hidden');
        }
      } catch (err) {
        formStatus.textContent = 'Network error. Please check your connection and try again.';
        formStatus.className = 'text-red-700 bg-red-50 border border-red-200 rounded-[6px] p-3 text-[14px]';
        formStatus.classList.remove('hidden');
      } finally {
        isSubmitting = false;
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        submitBtn.innerHTML = originalHtml;
      }
    });
  }
</script>
