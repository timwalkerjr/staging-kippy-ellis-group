---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const homeReviews = allReviews
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
---

<section id="testimonials" class="bg-surface py-20 lg:py-24 border-y border-border" data-ps="src/components/home/Testimonials.astro:test-sec">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/components/home/Testimonials.astro:rl25kv">
    <!-- Section Header -->
    <div class="text-center max-w-[680px] mx-auto mb-14" data-ps="src/components/home/Testimonials.astro:rl25kw">
      <span class="text-[12px] font-bold text-primary tracking-[0.15em] uppercase mb-2 block" data-ps="src/components/home/Testimonials.astro:pdgp87">Testimonials</span>
      <h2 class="font-heading text-[30px] font-normal text-foreground leading-[1.2]" data-ps="src/components/home/Testimonials.astro:o88ciy">
        What Our Clients Are Saying
      </h2>
    </div>

    <!-- 3 Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/Testimonials.astro:rl25kx">
      {homeReviews.map((review, __idx) => (
        <div class="bg-white border border-border p-8 rounded-[8px] flex flex-col justify-between shadow-xs" data-ps={`src/components/home/Testimonials.astro:card-${__idx}`}>
          <div data-ps={`src/components/home/Testimonials.astro:content-${__idx}`}>
            <!-- Stars -->
            <div class="flex items-center gap-1 text-amber-500 mb-4" data-ps={`src/components/home/Testimonials.astro:stars-${__idx}`}>
              {Array.from({ length: review.data.rating ?? 5 }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <h3 class="font-heading text-[18px] font-semibold text-foreground leading-[1.3] mb-4" data-ps={`src/components/home/Testimonials.astro:quote-${__idx}`}>
              "{review.data.quote}"
            </h3>
            <p class="text-[14px] text-muted-foreground leading-[24px]" data-ps={`src/components/home/Testimonials.astro:body-${__idx}`}>
              "{review.data.body}"
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-border" data-ps={`src/components/home/Testimonials.astro:author-wrap-${__idx}`}>
            <p class="text-[14px] font-semibold text-foreground" data-ps={`src/components/home/Testimonials.astro:name-${__idx}`}>— {review.data.name}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
