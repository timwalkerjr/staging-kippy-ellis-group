---
// Navigation - 1:1 visual match with original header
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

export interface Props {
  logo?: string;
}
---

<header id="navbar" class="sticky top-0 z-50 bg-white border-b border-border shadow-xs" data-ps="src/components/Navigation.astro:dt8k87">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/Navigation.astro:m59h3b">
    <div class="flex items-center justify-between min-h-[84px] lg:h-[104px] py-2 lg:py-0 gap-3" data-ps="src/components/Navigation.astro:navwrap">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 sm:gap-3 no-underline group min-w-0" data-ps="src/components/Navigation.astro:kd8n5y">
        <img
          src="https://pagesmith-cdn.com/ab210347/images/svg-render-320.webp"
          srcset="https://pagesmith-cdn.com/ab210347/images/svg-render-320.webp 320w, https://pagesmith-cdn.com/ab210347/images/svg-render-640.webp 640w"
          sizes="88px"
          width="88"
          height="88"
          alt="Kippy Ellis Group — West Michigan Real Estate"
          class="w-[68px] h-[68px] lg:w-[88px] lg:h-[88px] object-contain shrink-0"
          data-ps="src/components/Navigation.astro:gqvsd6"
        />
        <div class="flex flex-col min-w-0" data-ps="src/components/Navigation.astro:gqvsd7">
          <span class="font-heading text-[17px] font-bold text-foreground leading-tight tracking-tight" data-ps="src/components/Navigation.astro:7xpc9p">Kippy Ellis Group</span>
          <span class="text-[10px] tracking-[0.2em] font-semibold text-muted-foreground uppercase leading-none mt-0.5" data-ps="src/components/Navigation.astro:7xpc9o">FIVE STAR REAL ESTATE</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden xl:flex items-center gap-7" data-ps="src/components/Navigation.astro:gqvsdd">
        <a href="/" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjqk">Home</a>
        <a href="/#buying-selling" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjqm">Buying / Selling</a>
        <a href="/#about" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:kd8n5t">About Us</a>
        <a href="/#areas" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:kd8n5s">West Michigan</a>
        <a href="/testimonials" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjrf">Testimonials</a>
        <a href="/#contact" class="text-[14px] font-medium text-foreground hover:text-primary no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjre">Contact</a>

        <div class="relative group py-2" data-ps="src/components/Navigation.astro:gqvsdc">
          <button type="button" class="text-[14px] font-medium text-foreground hover:text-primary flex items-center gap-1 cursor-pointer" data-ps="src/components/Navigation.astro:4mv8j">
            <span data-ps="src/components/Navigation.astro:7xpc9l">More</span>
            <svg class="w-3.5 h-3.5 text-muted-foreground group-hover:text-primary transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full hidden group-hover:block bg-white border border-border rounded-[6px] shadow-lg py-2 min-w-[180px] z-50" data-ps="src/components/Navigation.astro:gqvsdd">
            <a href="/team" class="block px-4 py-2 text-[13px] text-foreground hover:bg-surface hover:text-primary no-underline" data-ps="src/components/Navigation.astro:7vkjrd">Our Team</a>
            <a href="/#faq" class="block px-4 py-2 text-[13px] text-foreground hover:bg-surface hover:text-primary no-underline" data-ps="src/components/Navigation.astro:7vkjrh">FAQ</a>
          </div>
        </div>
      </nav>

      <!-- Right Action & Mobile Toggle -->
      <div class="flex items-center gap-4" data-ps="src/components/Navigation.astro:gqvsdc">
        <a
          href="tel:+16164370205"
          class="hidden sm:inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-white text-[14px] font-semibold px-4 py-2 rounded-[6px] transition-colors no-underline shadow-xs"
         data-ps="src/components/Navigation.astro:7vkjri">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span data-ps="src/components/Navigation.astro:i2om69">(616) 437-0205</span>
        </a>

        <button
          id="mobile-menu-button"
          type="button"
          class="xl:hidden p-2 text-foreground hover:text-primary rounded-[6px] focus:outline-hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-ps="src/components/Navigation.astro:5ds1"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden overflow-hidden bg-white border-t border-border shadow-md"
    role="navigation"
    aria-label="Mobile navigation"
    data-ps="src/components/Navigation.astro:gqvsde"
  >
    <div class="px-6 py-4 flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsde">
      <a href="/" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:7vkjrj">Home</a>
      <a href="/#buying-selling" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:7vkjs6">Buying / Selling</a>
      <a href="/#about" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:kd8n5r">About Us</a>
      <a href="/#areas" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:7vkjs7">West Michigan</a>
      <a href="/team" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:kd8n5q">Our Team</a>
      <a href="/testimonials" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:7vkjsa">Testimonials</a>
      <a href="/#contact" class="text-[15px] font-medium text-foreground py-2 border-b border-border/50 no-underline hover:text-primary" data-ps="src/components/Navigation.astro:7vkjs9">Contact</a>
      <a href="tel:+16164370205" class="mt-2 text-center bg-primary text-white font-semibold py-3 px-4 rounded-[6px] no-underline" data-ps="src/components/Navigation.astro:kd8n5q">Call (616) 437-0205</a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
