---
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const sortedReviews = allReviews.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

function getInitials(name: string, fallback?: string): string {
  if (fallback) return fallback;
  const parts = name.split(' ').filter(Boolean);
  if (parts.length >= 2) return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  return (name.slice(0, 2) || 'KE').toUpperCase();
}
---

<section id="testimonials-list" class="bg-surface" data-ps="src/components/testimonials/TestimonialsList.astro:gbw1h3">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-8 py-16 lg:py-20" data-ps="src/components/testimonials/TestimonialsList.astro:99icdc">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ps="src/components/testimonials/TestimonialsList.astro:99icdd">
      {sortedReviews.map((review, __psIdx) => {
        const item = review.data;
        const initials = getInitials(item.name, item.initials);
        const rating = item.rating ?? 5;

        return (
          <article id={review.id} class="bg-white border border-border rounded-[8px] p-7 hover-lift flex flex-col justify-between" data-ps={`src/components/testimonials/TestimonialsList.astro:de29t8-${__psIdx}`}>
            <div data-ps={`src/components/testimonials/TestimonialsList.astro:99icdg-${__psIdx}`}>
              <div class="flex items-center justify-between mb-3" data-ps={`src/components/testimonials/TestimonialsList.astro:99icde-${__psIdx}`}>
                <div class="flex items-center gap-1 text-amber-500" data-ps={`src/components/testimonials/TestimonialsList.astro:99icdf-${__psIdx}`}>
                  {Array.from({ length: rating }).map(() => (
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  ))}
                </div>
                <span class="text-[12px] text-muted-foreground font-medium" data-ps={`src/components/testimonials/TestimonialsList.astro:qyuosd-${__psIdx}`}>{item.date}</span>
              </div>
              <h4 class="font-heading text-[18px] text-foreground font-normal leading-[1.4]" data-ps={`src/components/testimonials/TestimonialsList.astro:qb7t8b-${__psIdx}`}>&ldquo;{item.quote}&rdquo;</h4>
              <p class="text-[14px] text-muted-foreground leading-[22px] mt-4" data-ps={`src/components/testimonials/TestimonialsList.astro:5riw9u-${__psIdx}`}>{item.body}</p>
            </div>
            <div data-ps={`src/components/testimonials/TestimonialsList.astro:99icdh-${__psIdx}`}>
              <a href="/#contact" class="text-[13px] font-semibold text-primary hover:text-primary-hover mt-4 inline-flex items-center gap-1.5" data-ps={`src/components/testimonials/TestimonialsList.astro:tj3rna-${__psIdx}`}>Read full review <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg></a>
              <div class="mt-6 pt-5 border-t border-border flex items-center gap-3" data-ps={`src/components/testimonials/TestimonialsList.astro:99icdg-${__psIdx}`}>
                <div class="w-11 h-11 rounded-full bg-primary text-white flex items-center justify-center font-semibold text-[14px] flex-shrink-0" data-ps={`src/components/testimonials/TestimonialsList.astro:99icdh-${__psIdx}`}>
                  {initials}
                </div>
                <span class="text-[14px] font-semibold text-foreground" data-ps={`src/components/testimonials/TestimonialsList.astro:qyuosc-${__psIdx}`}>{item.name}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
