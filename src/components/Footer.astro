---
// Footer component
import { SITE } from '@/config/site';

export interface Props {
  companyName?: string;
  copyright?: string;
}

const {
  companyName = 'Kippy Ellis Group',
  copyright = `© 2026 ${companyName} · Five Star Real Estate. All rights reserved.`,
} = Astro.props;
---

<footer class="bg-dark-background text-dark-foreground py-16 lg:py-20 border-t border-dark-border relative" data-ps="src/components/Footer.astro:ikmf33">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/components/Footer.astro:p4vf83">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 mb-12" data-ps="src/components/Footer.astro:p4vf84">
      <!-- Column 1: Brand Info (5 cols) -->
      <div class="md:col-span-5 flex flex-col items-start" data-ps="src/components/Footer.astro:p4vf85">
        <a href="/" class="flex items-center gap-3 no-underline mb-4 group" data-ps="src/components/Footer.astro:7gqbzm">
          <div class="w-10 h-10 rounded-[6px] bg-primary flex items-center justify-center text-white shrink-0 shadow-xs" data-ps="src/components/Footer.astro:p4vf86">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div class="flex flex-col" data-ps="src/components/Footer.astro:p4vf87">
            <span class="font-heading text-[18px] font-bold text-dark-foreground leading-tight" data-ps="src/components/Footer.astro:abywzu">Kippy Ellis Group</span>
            <span class="text-[10px] tracking-[0.2em] font-semibold text-dark-muted-foreground uppercase leading-none mt-0.5" data-ps="src/components/Footer.astro:abywzv">FIVE STAR REAL ESTATE</span>
          </div>
        </a>
        <p class="text-[14px] text-dark-muted-foreground leading-[24px] max-w-[380px]" data-ps="src/components/Footer.astro:csfaq">
          Your Home, My Priority. Dedicated West Michigan real estate services with Five Star Real Estate, serving Grand Rapids, Holland, the Lakeshore, and surrounding communities.
        </p>
        <div class="flex items-center gap-4 mt-4" data-ps="src/components/Footer.astro:p4vf8b">
          <a href="https://www.facebook.com/kippy.miles.7/" target="_blank" rel="noopener noreferrer" class="text-dark-muted-foreground hover:text-white transition-colors" aria-label="Facebook" data-ps="src/components/Footer.astro:8o2pk">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/kippy.ellis/" target="_blank" rel="noopener noreferrer" class="text-dark-muted-foreground hover:text-white transition-colors" aria-label="Instagram" data-ps="src/components/Footer.astro:8o2pl">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Explore Links (3 cols) -->
      <div class="md:col-span-3" data-ps="src/components/Footer.astro:p4vf88">
        <h3 class="font-heading text-[16px] font-semibold text-dark-foreground mb-4" data-ps="src/components/Footer.astro:hj5oha">Explore</h3>
        <ul class="list-none p-0 m-0 flex flex-col gap-2.5 text-[14px]">
          <li data-ps="src/components/Footer.astro:wyji5o"><a href="/" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzn">Home</a></li>
          <li data-ps="src/components/Footer.astro:wyji5q"><a href="/#buying-selling" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzp">Buying / Selling</a></li>
          <li data-ps="src/components/Footer.astro:wyji5r"><a href="/#about" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:8o2pm">About Kippy</a></li>
          <li data-ps="src/components/Footer.astro:wyji5s"><a href="/testimonials" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzr">Testimonials</a></li>
          <li data-ps="src/components/Footer.astro:sq28da"><a href="/team" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:8o2pn">Our Team</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact Info (4 cols) -->
      <div class="md:col-span-4" data-ps="src/components/Footer.astro:p4vf89">
        <h3 class="font-heading text-[16px] font-semibold text-dark-foreground mb-4" data-ps="src/components/Footer.astro:fh1w6e">Contact</h3>
        <ul class="list-none p-0 m-0 flex flex-col gap-2.5 text-[14px] text-dark-muted-foreground leading-[22px]">
          <li data-ps="src/components/Footer.astro:wyji6e">Five Star Real Estate</li>
          <li data-ps="src/components/Footer.astro:wyji6f">West Michigan & Lakeshore</li>
          <li class="pt-1" data-ps="src/components/Footer.astro:wyji6g">
            <a href="tel:+16164370205" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline font-medium" data-ps="src/components/Footer.astro:7gqc0d">(616) 437-0205</a>
          </li>
          <li data-ps="src/components/Footer.astro:wyji6h">
            <a href="mailto:kippy@fivestar.com" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline break-all" data-ps="src/components/Footer.astro:7gqc0e">
              kippy@fivestar.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="border-t border-dark-border pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-dark-muted-foreground" data-ps="src/components/Footer.astro:p4vf8a">
      <p data-ps="src/components/Footer.astro:csfar">© 2026 Kippy Ellis Group · Five Star Real Estate. All rights reserved.</p>
      <div class="flex items-center gap-6" data-ps="src/components/Footer.astro:p4vf8b">
        <a href="/#" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0f">Privacy</a>
        <a href="/#" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0g">Terms</a>
        <a href="/#" class="text-dark-muted-foreground hover:text-dark-foreground transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0h">Accessibility</a>
      </div>
    </div>
  </div>
</footer>
