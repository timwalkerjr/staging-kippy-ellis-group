---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { SEO, pageGraph, absoluteUrl, personSchema } from '@/config/seo';

const agentsEntries = await getCollection('agents');
const sortedAgents = agentsEntries
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const renderedAgents = await Promise.all(
  sortedAgents.map(async (agent) => {
    const { Content } = await render(agent);
    const hasBody = Boolean(agent.body && agent.body.trim().length > 0);
    return { agent, Content, hasBody };
  })
);

const people = sortedAgents.map(agent => personSchema(agent.data, absoluteUrl('/team/#' + agent.id), absoluteUrl('/team/#' + agent.id)));
const list = { '@type': 'ItemList', '@id': absoluteUrl('/team/#team-list'), name: 'Kippy Ellis Group Realtors', numberOfItems: people.length, itemListElement: people.map((person, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@id': person['@id'] } })) };
const teamJsonLd = pageGraph('/team/', SEO.team, ['AboutPage', 'CollectionPage'], [...people, list], { mainEntity: { '@id': list['@id'] } });
---

<BaseLayout
  title={SEO.team.title}
  description={SEO.team.description}
  jsonLd={teamJsonLd}
>
  <!-- Hero Section -->
  <section class="bg-white py-16 lg:py-20 border-b border-border" data-ps="src/pages/team.astro:juxuyk">
    <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12 text-center" data-ps="src/pages/team.astro:yb61y7">
      <span class="text-[12px] font-bold text-primary tracking-[0.15em] uppercase mb-2 block" data-ps="src/pages/team.astro:oiar69">Five Star Real Estate</span>
      <h1 class="font-heading text-[36px] lg:text-[48px] font-normal text-foreground leading-[1.1] mb-4" data-ps="src/pages/team.astro:qwvgmm">
        Our Team
      </h1>
      <p class="text-[16px] sm:text-[18px] text-muted-foreground leading-[28px] max-w-[720px] mx-auto" data-ps="src/pages/team.astro:vgx3ej">
        Dedicated professionals bringing unmatched local expertise, client-first advocacy, and deep community roots across Grand Rapids, Holland, and the West Michigan Lakeshore.
      </p>
    </div>
  </section>

  <!-- Agent Grid Section -->
  <section class="bg-surface py-16 lg:py-24" data-ps="src/pages/team.astro:juxuyj">
    <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12" data-ps="src/pages/team.astro:yb61y8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" data-ps="src/pages/team.astro:a9sl7s">
        {renderedAgents.map(({ agent, Content, hasBody }, __psIdx) => {
          const { name, role, phone, email, experience, bio, specialties, photo, image, featured } = agent.data;
          const agentPhoto = image || photo;
          return (
            <div id={agent.id} class="bg-white border border-border rounded-[8px] overflow-hidden flex flex-col shadow-xs hover:shadow-md transition-shadow group" data-ps={`src/pages/team.astro:a9sl7t-${__psIdx}`}>
              <!-- Agent Photo -->
              <div class="relative w-full aspect-4/3 overflow-hidden bg-gray-100" data-ps={`src/pages/team.astro:a9sl7u-${__psIdx}`}>
                <img
                  src={agentPhoto}
                  alt={name}
                  class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
                  loading="lazy" data-ps={`src/pages/team.astro:vswxmn-${__psIdx}`} />
                {featured && (
                  <div class="absolute top-3 right-3 bg-primary text-white text-[11px] font-semibold uppercase tracking-wider px-3 py-1 rounded-[4px] shadow-sm" data-ps={`src/pages/team.astro:a9sl7v-${__psIdx}`}>
                    Team Lead
                  </div>
                )}
              </div>

              <!-- Agent Details -->
              <div class="p-6 flex flex-col flex-1" data-ps={`src/pages/team.astro:a9sl7w-${__psIdx}`}>
                <div class="mb-4" data-ps={`src/pages/team.astro:a9sl7x-${__psIdx}`}>
                  <h2 class="font-heading text-[22px] font-bold text-foreground mb-1" data-ps={`src/pages/team.astro:tfto4w-${__psIdx}`}>{name}</h2>
                  <p class="text-[14px] font-medium text-primary mb-1" data-ps={`src/pages/team.astro:vgx3ek-${__psIdx}`}>{role}</p>
                  <p class="text-[12px] font-semibold text-muted-foreground uppercase tracking-wider" data-ps={`src/pages/team.astro:vgx3el-${__psIdx}`}>{experience}</p>
                </div>

                <p class="text-[14px] text-muted-foreground leading-[22px] mb-6 flex-1" data-ps={`src/pages/team.astro:vgx3em-${__psIdx}`}>
                  {bio}
                </p>

                <!-- Specialties -->
                <div class="mb-5" data-ps={`src/pages/team.astro:a9sl7y-${__psIdx}`}>
                  <p class="text-[11px] font-bold text-foreground uppercase tracking-wider mb-2" data-ps={`src/pages/team.astro:vgx3en-${__psIdx}`}>Specialties</p>
                  <div class="flex flex-wrap gap-1.5" data-ps={`src/pages/team.astro:a9sl7z-${__psIdx}`}>
                    {specialties.map((spec, __psIdx2) => (
                      <span class="text-[11px] font-medium text-primary bg-primary/10 px-2.5 py-0.5 rounded-[4px]" data-ps={`src/pages/team.astro:oiar6a-${__psIdx2}`}>
                        {spec}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Full Bio Accordion -->
                {hasBody && (
                  <details class="group/acc mb-6 border border-border rounded-[6px] overflow-hidden bg-surface/60 transition-colors open:bg-surface">
                    <summary class="flex items-center justify-between p-3 cursor-pointer select-none text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors list-none [&::-webkit-details-marker]:hidden">
                      <span class="flex items-center gap-2" data-ps={`src/pages/team.astro:oewg2w-${__psIdx}`}>
                        <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Learn More
                      </span>
                      <svg class="w-4 h-4 text-primary transition-transform duration-200 group-open/acc:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <div class="px-3.5 pb-3.5 pt-2 text-[13px] text-muted-foreground leading-[22px] border-t border-border/60 prose prose-sm max-w-none prose-p:my-2 prose-a:text-primary prose-strong:text-foreground" data-ps={`src/pages/team.astro:a9sl81-${__psIdx}`}>
                      <Content />
                    </div>
                  </details>
                )}

                <!-- Contact CTAs -->
                <div class="pt-4 border-t border-border flex flex-col gap-2 mt-auto" data-ps={`src/pages/team.astro:a9sl80-${__psIdx}`}>
                  <a
                    href={`tel:${phone.replace(/[^0-9+]/g, '')}`}
                    class="flex items-center gap-2 text-[13px] text-foreground hover:text-primary transition-colors no-underline font-medium"
                   data-ps={`src/pages/team.astro:wg91vj-${__psIdx}`}>
                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span data-ps={`src/pages/team.astro:oiar6b-${__psIdx}`}>{phone}</span>
                  </a>
                  {email.trim() && (
                    <a
                      href={`mailto:${email}`}
                      class="flex items-center gap-2 text-[13px] text-primary hover:text-primary-hover transition-colors no-underline font-medium truncate"
                     data-ps={`src/pages/team.astro:wg91vi-${__psIdx}`}>
                      <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <span class="truncate" data-ps={`src/pages/team.astro:oiar6c-${__psIdx}`}>{email}</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Join Team CTA -->
  <section class="bg-secondary py-16 text-white text-center" data-ps="src/pages/team.astro:juxuyi">
    <div class="max-w-[800px] mx-auto px-6 sm:px-8" data-ps="src/pages/team.astro:a9sl81">
      <h2 class="font-heading text-[28px] lg:text-[34px] font-normal mb-4" data-ps="src/pages/team.astro:tfto4x">
        Looking to Buy or Sell in West Michigan?
      </h2>
      <p class="text-[16px] text-white/90 leading-[26px] mb-8 max-w-[600px] mx-auto" data-ps="src/pages/team.astro:vgx3f9">
        Connect with our experienced team today for personalized guidance, market valuations, and tailored property tours.
      </p>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center bg-white text-secondary hover:bg-surface font-semibold text-[14px] px-8 py-3.5 rounded-[6px] transition-colors no-underline shadow-sm"
       data-ps="src/pages/team.astro:wg91uw">
        Get in Touch With Us
      </a>
    </div>
  </section>
</BaseLayout>
